# Local development only. Copy to .env; Django loads backend/.env locally.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DEMO_AUTH_MODE=true
DEMO_AUTH_USER_ID=preview-visitor
DATABASE_URL=

# OpenAI API (server-side only). Create an API key in your OpenAI platform account.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=
LLM_TIMEOUT=20
LLM_MAX_TOKENS=500

# Moodle is deliberately disabled until DMI ICT authorizes and configures it.
MOODLE_ENABLED=false
MOODLE_REST_URL=
MOODLE_SERVICE_TOKEN=
